# Render Options
actiniumextra.option.render.fog=Fog
actiniumextra.option.render.fog.tooltip=If enabled, fog will be rendered.
actiniumextra.option.render.fog_start=Fog Start Multiplier
actiniumextra.option.render.fog_start.tooltip=Adjusts when the terrain fog begins to render for the player.
actiniumextra.option.render.fog_distance=Fog Distance
actiniumextra.option.render.fog_distance.tooltip=Controls the fog render distance in chunks. 0 = Default (uses render distance).
actiniumextra.option.render.prevent_shaders=Prevent Shaders
actiniumextra.option.render.prevent_shaders.tooltip=If enabled, any type of vanilla shaders will be prevented from loading. For example, the distorted view when spectating from a spider's point of view.
actiniumextra.option.render.clouds=Clouds
actiniumextra.option.render.clouds.tooltip=If enabled, clouds are rendered.
actiniumextra.option.render.modern_clouds=Modern Clouds
actiniumextra.option.render.modern_clouds.tooltip=Uses the Minecraft 1.21.6 cloud texture with the existing renderer. AssetMover 2.5 downloads the texture. Keeps cloud height, distance, and scale settings; user resource packs take priority. Applying this option reloads resources.
actiniumextra.option.render.cloud_height=Cloud Height
actiniumextra.option.render.cloud_height.tooltip=Controls the height of clouds that are rendered.
actiniumextra.option.render.cloud_distance=Cloud Distance
actiniumextra.option.render.cloud_distance.tooltip=Controls the cloud render distance in chunks. 0 = Default (uses game render distance).
actiniumextra.option.render.cloud_scale=Cloud Scale
actiniumextra.option.render.cloud_scale.tooltip=Controls the size of clouds from 0.25x to 4.00x. 1.00x is the vanilla default.
actiniumextra.option.render.cloud_translucency=Cloud Translucency
actiniumextra.option.render.cloud_translucency.tooltip=Controls when clouds become translucent. Default: based on cloud height. Always: clouds are always translucent. Never: clouds are always opaque.
actiniumextra.option.cloud_translucency.default=Default
actiniumextra.option.cloud_translucency.always=Always
actiniumextra.option.cloud_translucency.never=Never
actiniumextra.option.render.light_updates=Light Updates
actiniumextra.option.render.light_updates.tooltip=If disabled, light updates will not be processed. This can improve performance but may cause visual artifacts.
actiniumextra.option.render.item_frames=Item Frames
actiniumextra.option.render.item_frames.tooltip=If enabled, item frames are rendered.
actiniumextra.option.render.item_frame_lod_distance=Item Frame LOD Distance
actiniumextra.option.render.item_frame_lod_distance.tooltip=Beyond this distance (in blocks), framed items render with fewer faces and framed maps are hidden. 0 = Off.
actiniumextra.option.render.armor_stands=Armor Stands
actiniumextra.option.render.armor_stands.tooltip=If enabled, armor stands are rendered.
actiniumextra.option.render.paintings=Paintings
actiniumextra.option.render.paintings.tooltip=If enabled, paintings are rendered.
actiniumextra.option.render.pistons=Pistons
actiniumextra.option.render.pistons.tooltip=If enabled, piston extending animations are rendered.
actiniumextra.option.render.beacons=Beacon Beam
actiniumextra.option.render.beacons.tooltip=If enabled, beacon beams are rendered.
actiniumextra.option.render.limit_beacon_beam_height=Limit Beacon Beam Height
actiniumextra.option.render.limit_beacon_beam_height.tooltip=If enabled, beacon beams will be limited to the maximum height of the world.
actiniumextra.option.render.enchanting_books=Enchanting Table Book
actiniumextra.option.render.enchanting_books.tooltip=If enabled, enchanting table books are rendered.
actiniumextra.option.render.player_name_tag=Player Name Tag
actiniumextra.option.render.player_name_tag.tooltip=If enabled, player name tags will be visible.
actiniumextra.option.render.item_frame_name_tag=Item Frame Name Tag
actiniumextra.option.render.item_frame_name_tag.tooltip=If enabled, item frame name tags will be visible.

# Extra Options
actiniumextra.option.extra.fps=Show FPS
actiniumextra.option.extra.fps.tooltip=Displays the current FPS of the game on the overlay.
actiniumextra.option.extra.fps_extended=Show FPS Extended
actiniumextra.option.extra.fps_extended.tooltip=Displays additional information (average, 1%% low, and 0.1%% low FPS) alongside current FPS on the overlay.
actiniumextra.option.extra.coords=Show Coordinates
actiniumextra.option.extra.coords.tooltip=Displays player coordinates on the overlay.
actiniumextra.option.extra.ignore_reduced_debug_info=Ignore Reduced Debug Info
actiniumextra.option.extra.ignore_reduced_debug_info.tooltip=If enabled, coordinates will be shown even when reduced debug info is active (e.g., on servers with reducedDebugInfo gamerule).
actiniumextra.option.extra.overlay_corner=Overlay Corner
actiniumextra.option.extra.overlay_corner.tooltip=Determines in which corner of the screen the overlay (FPS and Coordinates) will be rendered.
actiniumextra.option.extra.text_contrast=Text Contrast
actiniumextra.option.extra.text_contrast.tooltip=Adjusts the contrast of the FPS/Coordinates counter. None: Default plain white text. Background: Renders a background to the text like the debug menu. Shadow: Plain white text with shadow.
actiniumextra.option.extra.vertical_sync=VSync
actiniumextra.option.extra.vertical_sync.tooltip=Controls vertical synchronization mode. Off: VSync disabled, may cause screen tearing. On: Standard VSync, limits FPS to refresh rate. Adaptive: Enables VSync when above refresh rate, disables when below to reduce stuttering. Only available if supported by GPU driver.
actiniumextra.option.screen_mode=Screen Mode
actiniumextra.option.screen_mode.tooltip=Windowed: Standard window mode. Borderless: Fullscreen without exclusive mode, allows easy alt-tab and multi-monitor use. Fullscreen: Exclusive fullscreen mode.
actiniumextra.option.screen_mode.windowed=Windowed
actiniumextra.option.screen_mode.borderless=Borderless
actiniumextra.option.screen_mode.fullscreen=Fullscreen
actiniumextra.option.extra.mod_name_tooltip=Mod Name Tooltip
actiniumextra.option.extra.mod_name_tooltip.tooltip=Shows the source mod’s name at the bottom of every item’s tooltip.
actiniumextra.option.extra.steady_debug_hud=Steady Debug Hud
actiniumextra.option.extra.steady_debug_hud.tooltip=If enabled, the debug hud will be refreshed every set number of ticks, configured by the Steady Debug Hud Refresh Interval.
actiniumextra.option.extra.steady_debug_hud_refresh=Steady Debug Hud Refresh Interval
actiniumextra.option.extra.steady_debug_hud_refresh.tooltip=Adjusts the interval, in ticks, at which the debug hud is refreshed.
actiniumextra.option.extra.toasts=Toasts
actiniumextra.option.extra.toasts.tooltip=Shows advancement and recipe popups (toasts).
actiniumextra.option.extra.toast_advancement=Advancement Toasts
actiniumextra.option.extra.toast_advancement.tooltip=Shows advancement popups (toasts).
actiniumextra.option.extra.toast_recipe=Recipe Toasts
actiniumextra.option.extra.toast_recipe.tooltip=Shows recipe popups (toasts).
actiniumextra.option.extra.toast_tutorial=Tutorial Toasts
actiniumextra.option.extra.toast_tutorial.tooltip=Shows tutorial popups (toasts).
actiniumextra.option.extra.toast_system=System Toasts
actiniumextra.option.extra.toast_system.tooltip=Shows system popups (toasts).

